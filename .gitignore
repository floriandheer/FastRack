# OS
Thumbs.db
.DS_Store
desktop.ini

# User data
data/
backups/
output/

# WooCommerce Monitor - Sensitive data
modules/woocommerce_monitor_data/config.json
modules/woocommerce_monitor_data/processed_orders.json
modules/woocommerce_monitor_data/*.log

# Global Invoice - runtime data now lives in user AppData; ignore the
# legacy in-repo folder so leftovers from older checkouts can't slip in.
modules/global_invoice_data/

# Invoice templates - real per-company templates carry your legal name,
# VAT/IBAN/BIC and address, so only the generic placeholder-only starter
# template is committed. Drop your own filled-in .odt/.ott files here;
# they stay local.
templates/invoice_templates_ott/*
!templates/invoice_templates_ott/README.txt
!templates/invoice_templates_ott/Template_Factuur.odt

# Tools directory - binaries downloaded externally, keep README
tools/*
!tools/platform-tools/
tools/platform-tools/*
!tools/platform-tools/README.txt

# Old/backup Python files
*_OLD.py
*_OLD_*.py
*_BACKUP.py

# Configuration files that may contain secrets
*.conf
rclone.conf

# Setup config (user-specific paths, only .example is committed)
setup_config.json
# Per-machine state for workstation apps (skip-list, etc.)
setup_apps_state.json
Fastrack.lnk

# AI assistant
.claude/
